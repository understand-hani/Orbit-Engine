APP_NAME=Personal Infra Agent
# Use APP_ENV=demo only when an explicit pre-filled showcase account is wanted.
APP_ENV=development
TIMEZONE=Asia/Shanghai
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=../data/infra_agent.db

# Use "mock" for offline development, "openrouter" for real Deep Dive / JD agent calls.
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SEC=20
OPENROUTER_SITE_URL=

# Optional. GitHub unauthenticated search is rate-limited.
GITHUB_TOKEN=
SOURCE_TIMEOUT_SEC=10
BOCHA_API_KEY=
