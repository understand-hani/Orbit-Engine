APP_NAME=Personal Infra Agent
APP_ENV=development
TIMEZONE=Asia/Shanghai
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=../data/infra_agent.db

# Use "mock" for offline development, "openrouter" for real JD analysis.
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SEC=45
OPENROUTER_SITE_URL=

# Optional. GitHub unauthenticated search is rate-limited.
GITHUB_TOKEN=
SOURCE_TIMEOUT_SEC=10
